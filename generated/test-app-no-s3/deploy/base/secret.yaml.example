# =============================================================================
# EXAMPLE SECRET - Copy to secret.yaml and fill in actual values
# DO NOT COMMIT secret.yaml to git!
# =============================================================================
#
# This is an example of how to create the secret that the Knative Service
# references. You have several options for managing this secret:
#
# Option 1: Create manually with kubectl
# -------
# kubectl create secret generic rust-service-secrets \
#   --from-literal=redis-url='redis://:password@redis-host:6379/0' \
#   -n default
#
# Option 2: Store in this file (secret.yaml) locally, never commit it
# -------
# Copy this file to deploy/base/secret.yaml
# Fill in your actual secret values
# Add to .gitignore so it's never committed
#
# Option 3: External Secrets Operator (recommended for production)
# -------
# Use ExternalSecret to sync from AWS Secrets Manager, HashiCorp Vault, etc.
# Example ExternalSecret:
#
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   metadata:
#     name: rust-service-secrets
#   spec:
#     refreshInterval: 1h
#     secretStoreRef:
#       name: aws-secrets-manager
#     target:
#       name: rust-service-secrets
#     data:
#       - secretKey: redis-url
#         remoteRef:
#           key: /prod/rust-service/redis-url
#
# Option 4: Sealed Secrets (GitOps-friendly encryption)
# -------
# Use kubeseal to encrypt secrets before committing
# https://github.com/bitnami-labs/sealed-secrets
#
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: rust-service-secrets
  namespace: test-app
type: Opaque
stringData:
  # Redis connection URL
  # Format: redis://[:password@]host[:port][/db]
  #
  # Examples:
  #   redis://localhost:6379           (no auth)
  #   redis://:mypassword@redis:6379   (with password)
  #   redis://:password@host:6379/0    (with password and DB selection)
  #   rediss://secure-redis:6380       (with TLS)
  redis-url: "redis://:your-redis-password@redis-host:6379/0"

  

  # Add additional secrets as needed:
  # api-key: "your-api-key"
  # database-url: "postgres://user:pass@host/db"
  # jwt-secret: "your-jwt-secret"
