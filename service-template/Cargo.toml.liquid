[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.92"
description = "Thin service generated by the Rust Knative + FluxCD platform"
license = "MIT"

[[bin]]
name = "{{ crate_name }}"
path = "src/main.rs"

[dependencies]
# Shared workspace crates. The platform root owns versions.
anyhow = { workspace = true }
axum = { workspace = true }
metrics = { workspace = true }
serde = { workspace = true }
tokio = { workspace = true }
tower = { workspace = true }
tower-http = { workspace = true }
tracing = { workspace = true }
utoipa = { workspace = true }

# Rate limiting and the OpenAPI UI are service-only dependencies; they are not
# part of the platform workspace dependency table.
tower_governor = "0.7"
utoipa-swagger-ui = { version = "9", features = ["axum"] }

# Shared infrastructure: config, error, state, observability, middleware,
# health endpoints, Kafka publisher, and startup bootstrap.
service-core = { path = "../../crates/service-core", features = [{% if include_postgres %}"postgres", {% endif %}{% if include_s3 %}"s3", {% endif %}{% if kafka_publish %}"kafka"{% endif %}] }

{%- if kafka_source %}

# CloudEvents extractor for the Knative KafkaSource sink (Kellnr registry).
axum-cloudevents = { workspace = true }
{%- endif %}

{%- if include_postgres %}

# Embedded migrations are compiled into the binary at build time.
sqlx = { version = "0.8.6", features = ["runtime-tokio", "tls-rustls-ring", "postgres", "macros", "migrate"] }
{%- endif %}

[dev-dependencies]
serde_json = { workspace = true }
