[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.92"
authors = [" {{project_author}}" ]
description = "Rust microservice template for Knative + FluxCD"
license = "MIT"

[[bin]]
name = "{{ crate_name }}"
path = "src/main.rs"

[dependencies]
# Async Runtime
tokio = { version = "1.41", features = ["full"] }

# Web Framework
axum = { version = "0.8", features = ["macros"] }
tower = { version = "0.5", features = ["timeout"] }
tower-http = { version = "0.6", features = ["trace", "request-id", "propagate-header"] }

# Serialization
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# Configuration
figment = { version = "0.10", features = ["toml", "env", "test"] }

# OpenAPI
utoipa = { version = "5", features = ["axum_extras"] }
utoipa-swagger-ui = { version = "9", features = ["axum"] }

# CloudEvents support (vendored)
axum-cloudevents = { path = "crates/axum-cloudevents" }

# Observability - Tracing
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
tracing-opentelemetry = "0.32"

# Observability - OpenTelemetry
opentelemetry = "0.31"
opentelemetry_sdk = "0.31"
opentelemetry-otlp = { version = "0.31", features = ["grpc-tonic"] }
opentelemetry-semantic-conventions = "0.31"

# B3 Propagation (Critical for Knative)
opentelemetry-zipkin = { version = "0.31", default-features = false, features = ["reqwest-client"] }

# Metrics
metrics = "0.24"
metrics-exporter-prometheus = "0.18"

# Redis (no pool - multiplexed connection)
redis = { version = "0.24", features = ["tokio-comp", "connection-manager"] }

{% if feature_kafka %}
# Kafka Event Publishing
rdkafka = { version = "0.38", features = ["cmake-build", "tracing"] }

# Time handling (for Kafka event timestamps)
chrono = { version = "0.4", features = ["serde"] }

# UUID generation (for Kafka event IDs)
uuid = { version = "1.0", features = ["v4", "serde"] }
{% endif %}

{% if feature_s3 %}
# Object Storage (S3-compatible via OpenDAL)
opendal = { version = "0.55", default-features = false, features = ["services-s3"] }

{%- unless feature_kafka %}
# Time handling (for S3)
chrono = { version = "0.4", features = ["serde"] }

# UUID generation (for S3)
uuid = { version = "1.0", features = ["v4", "serde"] }
{%- endunless %}
{% endif %}

# Utilities
thiserror = "2.0"
anyhow = "1.0"

[dev-dependencies]
axum-test = "17"
tokio-test = "0.4"
# PostgreSQL integration testing
sqlx = { version = "0.8", features = ["runtime-tokio-rustls", "postgres", "json"] }
{%- if feature_s3 %}
figment = { version = "0.10", features = ["test"] }
{%- endif %}

# Build dependencies
[build-dependencies]
cargo-chef = "0.1"

[profile.release]
lto = true
codegen-units = 1
panic = "abort"
strip = true
