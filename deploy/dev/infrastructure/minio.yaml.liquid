{% if feature_s3 or feature_postgres %}
apiVersion: v1
kind: Namespace
metadata:
  name: minio
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: minio
  namespace: minio
spec:
  replicas: 1
  selector:
    matchLabels:
      app: minio
  template:
    metadata:
      labels:
        app: minio
    spec:
      containers:
      - name: minio
        image: minio/minio:latest
        command:
          - minio
          - server
          - /data
          - --console-address
          - ":9001"
        env:
          - name: MINIO_ROOT_USER
            value: "minioadmin"
          - name: MINIO_ROOT_PASSWORD
            value: "minioadmin"
        ports:
          - name: api
            containerPort: 9000
          - name: console
            containerPort: 9001
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /minio/health/live
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /minio/health/ready
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: minio
  namespace: minio
spec:
  selector:
    app: minio
  ports:
    - name: api
      port: 9000
      targetPort: 9000
    - name: console
      port: 9001
      targetPort: 9001
  type: ClusterIP
---
apiVersion: batch/v1
kind: Job
metadata:
  name: minio-init
  namespace: minio
spec:
  ttlSecondsAfterFinished: 60
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: mc
        image: minio/mc:latest
        env:
          - name: MC_HOST_local
            value: "http://minioadmin:minioadmin@minio.minio.svc.cluster.local:9000"
        command:
          - /bin/sh
          - -c
          - |
            until mc alias ls local; do
              echo "Waiting for MinIO..."
              sleep 2
            done
            {%- if feature_s3 %}
            mc mb local/data --ignore-existing || true
            {%- endif %}
            {%- if feature_postgres %}
            # Backup destination bucket for the CNPG ObjectStore: barman does
            # not create buckets, so the dev init job must create it upfront.
            mc mb "local/{{ project_name | replace: "_", "-" }}-postgres-backups" --ignore-existing || true
            {%- endif %}
            echo "Bucket creation completed"
{%- if feature_postgres %}
---
# Dev-only credentials for the CNPG barman-cloud ObjectStore. The
# ObjectStore CR references this secret by name (keys ACCESS_KEY_ID /
# ACCESS_SECRET_KEY). Rotate along with the minio creds when hardening dev.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-backup-storage
  namespace: default
type: Opaque
stringData:
  ACCESS_KEY_ID: "minioadmin"
  ACCESS_SECRET_KEY: "minioadmin"
{%- endif %}
{% endif %}
