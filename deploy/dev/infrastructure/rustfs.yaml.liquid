{% if feature_s3 or feature_postgres %}
apiVersion: v1
kind: Namespace
metadata:
  name: rustfs
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rustfs
  namespace: rustfs
spec:
  replicas: 1
  selector:
    matchLabels:
      app: rustfs
  template:
    metadata:
      labels:
        app: rustfs
    spec:
      containers:
      - name: rustfs
        image: rustfs/rustfs:1.0.1
        args:
          - /data
        env:
          - name: RUSTFS_ACCESS_KEY
            value: "rustfsadmin"
          - name: RUSTFS_SECRET_KEY
            value: "rustfsadmin"
        ports:
          - name: api
            containerPort: 9000
          - name: console
            containerPort: 9001
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "1Gi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /health/live
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health/ready
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: rustfs
  namespace: rustfs
spec:
  selector:
    app: rustfs
  ports:
    - name: api
      port: 9000
      targetPort: 9000
    - name: console
      port: 9001
      targetPort: 9001
  type: ClusterIP
---
apiVersion: batch/v1
kind: Job
metadata:
  name: rustfs-init
  namespace: rustfs
spec:
  ttlSecondsAfterFinished: 60
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: rc
        image: rustfs/rc:v0.1.36
        command:
          - /bin/sh
          - -c
          - |
            until rc alias set local http://rustfs.rustfs.svc.cluster.local:9000 rustfsadmin rustfsadmin >/dev/null 2>&1; do
              echo "Waiting for RustFS..."
              sleep 2
            done
            {%- if feature_s3 %}
            # App data bucket. Named after the ObjectBucketClaim the chart
            # creates in a real cluster (the claim's bucket takes its name);
            # local Kind has no bucket provisioner, so this init job stands in.
            rc bucket create -p "local/{{ project_name | replace: "_", "-" }}-app-data"
            {%- endif %}
            {%- if feature_postgres %}
            # Backup destination bucket for the CNPG ObjectStore: barman does
            # not create buckets, so the dev init job must create it upfront.
            # Mimics the chart's ObjectBucketClaim <project>-postgres-backups.
            rc bucket create -p "local/{{ project_name | replace: "_", "-" }}-postgres-backups"
            {%- endif %}
            echo "Bucket creation completed"
{%- if feature_postgres %}
---
# Dev-only stand-in for the ObjectBucketClaim provisioner contract: a
# claim-named Secret carrying the S3 credentials the CNPG barman-cloud
# ObjectStore consumes (keys AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# matching the lib-bucket-provisioner contract). Rotate along with the rustfs
# creds when hardening dev. This mimics what the provisioner creates for the
# local Kind cluster, which has no bucket provisioner.
apiVersion: v1
kind: Secret
metadata:
  name: {{ project_name | replace: "_", "-" }}-postgres-backups
  namespace: default
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "rustfsadmin"
  AWS_SECRET_ACCESS_KEY: "rustfsadmin"
{%- endif %}
{%- if feature_s3 %}
---
# Dev-only stand-ins for the ObjectBucketClaim provisioner contract used by
# the app: a claim-named Secret (credentials) and ConfigMap (connection
# identity). The app consumes these exactly as it would the objects the
# provisioner creates in a real cluster, so no env rewriting is needed between
# local Kind and Ceph. This is the local Kind fallback for the app-data claim.
apiVersion: v1
kind: Secret
metadata:
  name: {{ project_name | replace: "_", "-" }}-app-data
  namespace: default
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "rustfsadmin"
  AWS_SECRET_ACCESS_KEY: "rustfsadmin"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ project_name | replace: "_", "-" }}-app-data
  namespace: default
data:
  BUCKET_HOST: rustfs.rustfs.svc.cluster.local
  BUCKET_PORT: "9000"
  BUCKET_NAME: {{ project_name | replace: "_", "-" }}-app-data
{%- endif %}
{% endif %}
