apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: production

resources:
  - ../../base

patches:
  - target:
      kind: Service
      name: rust-service
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "{{ prod_min_scale }}"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "{{ prod_max_scale }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/cpu
        value: "{{ prod_cpu_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/memory
        value: "{{ prod_memory_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/cpu
        value: "{{ prod_cpu_limit }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: "{{ prod_memory_limit }}"

{% if features contains "s3" %}
# Production S3 configuration (typically AWS S3 or managed MinIO)
configMapGenerator:
  - name: s3-config
    behavior: create
    literals:
      - S3_ENDPOINT=https://s3.amazonaws.com  # or your MinIO endpoint
      - S3_BUCKET=data-prod
      - S3_REGION=us-east-1
{% endif %}
