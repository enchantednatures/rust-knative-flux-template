apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ project_name }}-postgres
  namespace: {{ target_namespace }}
spec:
  instances: 3  # Production: 3 instances (1 primary + 2 standby) - matches base
  
  # Production PostgreSQL configuration
  postgresql:
    parameters:
      # Production settings - high availability and durability
      synchronous_commit: "remote_apply"       # Quorum replication for zero data loss
      synchronous_standby_names: "ANY 1 (*)"  # At least 1 replica must confirm writes
      shared_buffers: "2Gi"                    # 25% of memory
      max_connections: "300"
  
  # Production resource allocation - matches base defaults
  resources:
    requests:
      cpu: "1"
      memory: "2Gi"
    limits:
      cpu: "2"
      memory: "4Gi"
  
  # Production storage
  storage:
    size: "200Gi"
    # storageClass: "fast-ssd"  # Uncomment and configure for production with specific storage class
