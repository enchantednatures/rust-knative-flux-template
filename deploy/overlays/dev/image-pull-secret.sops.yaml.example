# Template for the private-registry pull secret referenced by the
# `image_pull_secret` generation value.
#
# Create the real (encrypted) file with:
#   kubectl create secret docker-registry {{ image_pull_secret }} \
#     -n {{ target_namespace }} \
#     --docker-server=ghcr.io \
#     --docker-username=<github-user> \
#     --docker-password=<PAT with read:packages> \
#     --dry-run=client -o yaml | sops -e - > deploy/overlays/dev/image-pull-secret.sops.yaml
#
# then uncomment the `image-pull-secret.sops.yaml` entry under `resources:` in
# this directory's kustomization.yaml and commit the encrypted file. Flux
# decrypts it with the `sops-age` Secret in flux-system (see docs/SECURITY.md).
{% if image_pull_secret != "" %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ image_pull_secret }}
  namespace: {{ target_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <sops-encrypted>
{% endif %}
