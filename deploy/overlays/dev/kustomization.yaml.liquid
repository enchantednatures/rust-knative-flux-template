apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../base

patches:
  - target:
      kind: Service
      name: rust-service
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "{{ dev_min_scale }}"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "{{ dev_max_scale }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/cpu
        value: "{{ dev_cpu_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/memory
        value: "{{ dev_memory_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/cpu
        value: "{{ dev_cpu_limit }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: "{{ dev_memory_limit }}"

{% if include_s3 %}
# Environment-specific S3 configuration
# Override S3 endpoint to point to local MinIO during development
configMapGenerator:
  - name: s3-config
    behavior: create
    literals:
      - S3_ENDPOINT=http://minio:9000
      - S3_BUCKET=data
      - S3_REGION=us-east-1
{% endif %}
