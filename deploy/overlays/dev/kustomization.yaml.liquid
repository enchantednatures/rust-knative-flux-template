apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: default

resources:
  - ../../base

{% if event_sources contains "kafka" %}
patchesStrategicMerge:
  - kafka-source-patch.yaml
{% endif %}

patches:
  - target:
      kind: Service
      name: {{ project_name }}
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "{% if use_default_scaling %}0{% else %}{{ dev_min_scale }}{% endif %}"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "{% if use_default_scaling %}3{% else %}{{ dev_max_scale }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/cpu
        value: "{% if use_default_scaling %}100m{% else %}{{ dev_cpu_request }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/memory
        value: "{% if use_default_scaling %}64Mi{% else %}{{ dev_memory_request }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/cpu
        value: "{% if use_default_scaling %}500m{% else %}{{ dev_cpu_limit }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: "{% if use_default_scaling %}256Mi{% else %}{{ dev_memory_limit }}{% endif %}"
      - op: add
        path: /spec/template/spec/containers/0/env
        value:
           - name: APP__REDIS__URL
             value: "redis://redis.redis.svc.cluster.local:6379"
           {% if features contains "s3" %}
           - name: APP__S3__ENDPOINT
             value: "http://minio.minio.svc.cluster.local:9000"
          - name: APP__S3__BUCKET
            value: "data"
          - name: APP__S3__REGION
            value: "us-east-1"
          - name: AWS_ACCESS_KEY_ID
            value: "minioadmin"
          - name: AWS_SECRET_ACCESS_KEY
            value: "minioadmin"
          {% endif %}
          - name: APP__TELEMETRY__OTLP_ENDPOINT
            value: "http://otel-collector.observability.svc.cluster.local:4317"
          - name: APP__TELEMETRY__SERVICE_NAME
            value: "{{ project_name }}-dev"
          - name: APP__TELEMETRY__LOG_LEVEL
            value: "debug"
          - name: RUST_LOG
            value: "debug,hyper=info,tower=info"
