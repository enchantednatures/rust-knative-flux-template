apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: default

resources:
  - ../../base

patches:
  - target:
      kind: Service
      name: rust-service
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "0"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "3"

{% if include_s3 %}
# Environment-specific S3 configuration
# Override S3 endpoint to point to local MinIO during development
configMapGenerator:
  - name: s3-config
    behavior: create
    literals:
      - S3_ENDPOINT=http://minio:9000
      - S3_BUCKET=data
      - S3_REGION=us-east-1
{% endif %}
