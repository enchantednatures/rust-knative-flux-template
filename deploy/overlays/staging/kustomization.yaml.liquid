apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: staging

resources:
  - ../../base

patches:
  - target:
      kind: Service
      name: rust-service
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "{% if use_default_scaling %}1{% else %}{{ staging_min_scale }}{% endif %}"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "{% if use_default_scaling %}5{% else %}{{ staging_max_scale }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/cpu
        value: "{% if use_default_scaling %}200m{% else %}{{ staging_cpu_request }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/memory
        value: "{% if use_default_scaling %}128Mi{% else %}{{ staging_memory_request }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/cpu
        value: "{% if use_default_scaling %}800m{% else %}{{ staging_cpu_limit }}{% endif %}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: "{% if use_default_scaling %}384Mi{% else %}{{ staging_memory_limit }}{% endif %}"

 {% if features contains "s3" %}
# Staging-specific S3 configuration (may use MinIO or S3)
configMapGenerator:
  - name: s3-config
    behavior: create
    literals:
      - S3_ENDPOINT=https://minio.staging.svc.cluster.local:9000  # Update as needed
      - S3_BUCKET=data-staging
      - S3_REGION=us-east-1
 {% endif %}

{% if event_sources contains "kafka" %}
patchesStrategicMerge:
  - kafka-source-patch.yaml
{% endif %}

