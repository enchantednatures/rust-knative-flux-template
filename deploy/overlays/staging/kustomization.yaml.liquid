apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: staging

resources:
  - ../../base

patches:
  - target:
      kind: Service
      name: rust-service
    patch: |-
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1min-scale
        value: "{{ staging_min_scale }}"
      - op: add
        path: /spec/template/metadata/annotations/autoscaling.knative.dev~1max-scale
        value: "{{ staging_max_scale }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/cpu
        value: "{{ staging_cpu_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/requests/memory
        value: "{{ staging_memory_request }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/cpu
        value: "{{ staging_cpu_limit }}"
      - op: replace
        path: /spec/template/spec/containers/0/resources/limits/memory
        value: "{{ staging_memory_limit }}"

{% if features contains "s3" %}
# Staging-specific S3 configuration (may use MinIO or S3)
configMapGenerator:
  - name: s3-config
    behavior: create
    literals:
      - S3_ENDPOINT=https://minio.staging.svc.cluster.local:9000  # Update as needed
      - S3_BUCKET=data-staging
      - S3_REGION=us-east-1
{% endif %}
