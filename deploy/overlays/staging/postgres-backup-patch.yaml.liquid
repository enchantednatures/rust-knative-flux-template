apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: {{ project_name }}-postgres-daily-backup
  namespace: {{ target_namespace }}
spec:
  # Staging backup schedule - configurable via template variable
  schedule: "{{ backup_schedule }}"

---
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ project_name }}-postgres-backup-store
  namespace: {{ target_namespace }}
spec:
  configuration:
    destinationPath: s3://{{ project_name }}-postgres-backups/staging/
    endpointURL: http://minio.minio.svc.cluster.local:9000
    s3Credentials:
      accessKeyId:
        name: postgres-backup-storage
        key: ACCESS_KEY_ID
      secretAccessKey:
        name: postgres-backup-storage
        key: ACCESS_SECRET_KEY
  
  # Staging: medium retention (configurable via template)
  retentionPolicy: "{{ backup_retention_staging }}d"
  
  # Staging: zstd compression level 3
  configuration:
    data:
      compression: zstd
      jobs: 2
    wal:
      compression: zstd
      maxParallel: 4
