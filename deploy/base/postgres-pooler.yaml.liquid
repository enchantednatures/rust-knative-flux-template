apiVersion: postgresql.cnpg.io/v1
kind: Pooler
metadata:
  name: {{ project_name | replace: "_", "-" }}-postgres-pooler
  namespace: {{ target_namespace }}
spec:
  cluster:
    name: {{ project_name | replace: "_", "-" }}-postgres
  
  instances: 3  # Number of PgBouncer replicas for HA
  
  type: rw  # Read-write pooler (connects to primary)
  
  pgbouncer:
    poolMode: transaction  # Transaction pooling (most efficient)
    
    parameters:
      max_client_conn: "300"      # Maximum client connections
      default_pool_size: "25"     # Connections per database/user
      reserve_pool_size: "5"      # Reserve pool for high priority
      reserve_pool_timeout: "5"   # Timeout for reserve pool (seconds)
      max_db_connections: "100"   # Max connections to PostgreSQL
      
      # Connection lifecycle
      server_lifetime: "3600"     # Max server connection lifetime (1 hour)
      server_idle_timeout: "600"  # Idle server timeout (10 minutes)
      
      # Logging
      log_connections: "1"
      log_disconnections: "1"
      log_pooler_errors: "1"
  
  # Resources for PgBouncer pods
  resources:
    requests:
      cpu: "100m"
      memory: "128Mi"
    limits:
      cpu: "500m"
      memory: "256Mi"
  
  # Monitoring
  monitoring:
    enabled: true
    podMonitorEnabled: true
