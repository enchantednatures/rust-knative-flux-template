apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ project_name }}-postgres-alerts
  namespace: {{ target_namespace }}
  labels:
    app: {{ project_name }}-postgres
    prometheus: kube-prometheus
spec:
  groups:
    - name: postgres.rules
      interval: 30s
      rules:
        # ====================================================================
        # Backup Health Alerts
        # ====================================================================
        - alert: PostgreSQLBackupFailed
          expr: |
            (
              cnpg_collector_backup_last_failed_timestamp > 0
              and
              (time() - cnpg_collector_backup_last_failed_timestamp) < 600
            )
          for: 5m
          labels:
            severity: critical
            component: postgres
          annotations:
            summary: "PostgreSQL backup failed ({{ $labels.cluster }})"
            description: "Backup for PostgreSQL cluster {{ $labels.cluster }} failed within the last 5 minutes. This requires immediate attention."
        
        - alert: PostgreSQLBackupMissing
          expr: |
            (
              (time() - cnpg_collector_last_failed_backup_timestamp) > 86400
            )
          for: 1h
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL backup missing ({{ $labels.cluster }})"
            description: "No successful backup for PostgreSQL cluster {{ $labels.cluster }} in the last 24 hours. Please investigate."
        
        # ====================================================================
        # Replication Alerts
        # ====================================================================
        - alert: PostgreSQLReplicationLag
          expr: |
            cnpg_pg_replication_lag{cluster="{{ project_name }}-postgres"} > 10
          for: 5m
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL replication lag detected ({{ $labels.cluster }})"
            description: "Replication lag is {{ $value }}s for cluster {{ $labels.cluster }}, expected < 10s. Check replica availability."
        
        - alert: PostgreSQLHighReplicationLag
          expr: |
            cnpg_pg_replication_lag{cluster="{{ project_name }}-postgres"} > 60
          for: 2m
          labels:
            severity: critical
            component: postgres
          annotations:
            summary: "PostgreSQL high replication lag ({{ $labels.cluster }})"
            description: "Replication lag is {{ $value }}s for cluster {{ $labels.cluster }}. Immediate action required."
        
        # ====================================================================
        # Instance Health Alerts
        # ====================================================================
        - alert: PostgreSQLInstanceDown
          expr: |
            up{job="postgres-metrics"} == 0
          for: 1m
          labels:
            severity: critical
            component: postgres
          annotations:
            summary: "PostgreSQL instance down ({{ $labels.pod }})"
            description: "PostgreSQL pod {{ $labels.pod }} is not responding to metrics scrape for 1 minute."
        
        - alert: PostgreSQLNotReady
          expr: |
            pg_setting_server_version_num == 0
          for: 5m
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL not ready ({{ $labels.pod }})"
            description: "PostgreSQL instance {{ $labels.pod }} is not reporting version information. It may still be starting up."
        
        # ====================================================================
        # Storage Alerts
        # ====================================================================
        - alert: PostgreSQLDiskLow
          expr: |
            (
              node_filesystem_avail_bytes{fstype=~"ext4|xfs"} 
              / 
              node_filesystem_size_bytes{fstype=~"ext4|xfs"}
            ) < 0.1
          for: 10m
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL disk space low ({{ $labels.device }})"
            description: "Disk space on {{ $labels.device }} is below 10%. Estimated time remaining: {{ $value }}."
        
        # ====================================================================
        # WAL Archiving Alerts
        # ====================================================================
        - alert: PostgreSQLWALArchivingFailed
          expr: |
            pg_stat_archiver_failed_count > 0
          for: 5m
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL WAL archiving failed ({{ $labels.pod }})"
            description: "WAL archiving has failed {{ $value }} times on {{ $labels.pod }}. Check connectivity to backup storage."
        
        # ====================================================================
        # Connection Alerts
        # ====================================================================
        - alert: PostgreSQLHighConnections
          expr: |
            pg_stat_activity_count > 50
          for: 5m
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL high connection count ({{ $labels.pod }})"
            description: "PostgreSQL has {{ $value }} active connections, approaching typical limits. Consider investigating application behavior."
        
        # ====================================================================
        # Recovery/Failover Alerts
        # ====================================================================
        - alert: PostgreSQLRecoveryInProgress
          expr: |
            pg_is_in_recovery == 1
          labels:
            severity: warning
            component: postgres
          annotations:
            summary: "PostgreSQL in recovery mode ({{ $labels.pod }})"
            description: "PostgreSQL instance {{ $labels.pod }} is in recovery mode. It may be a replica or recovering from failure."
