# Example Kubernetes Secret for an EXTERNAL S3-compatible Object Storage store.
#
# This file is ONLY for the external-S3 escape hatch: when you route the CNPG
# backups (or the app) at a store you manage yourself instead of the
# chart-provisioned Ceph bucket. The default dev/staging/prod deployments do NOT
# use this file. There, the cluster's bucket provisioner creates the Secret
# "<project>-postgres-backups" (backups) and "<project>-app-data" (app) with the
# credentials, and the ObjectStore/app consume those directly.
#
# USAGE (external store only):
# 1. Copy this file: cp object-storage-secret.yaml.example object-storage-secret.yaml
# 2. Replace with your actual credentials and a NON-claim name (see below)
# 3. Encrypt with SOPS: sops -e -i object-storage-secret.yaml
# 4. Commit the encrypted version to Git
#
# WARNING: Never commit unencrypted secrets to Git.
# WARNING: Never reuse the provisioner-owned names "<project>-postgres-backups"
# or "<project>-app-data" for a Git-managed Secret. The provisioner rewrites
# those on every reconcile and would clobber your credentials.

apiVersion: v1
kind: Secret
metadata:
  # Deliberately NOT "<project>-postgres-backups": that name is owned by the
  # ObjectBucketClaim provisioner. Use an external-suffixed name for the escape
  # hatch and reference it from the ObjectStore's s3Credentials / app env.
  name: postgres-backups-external
  namespace: default
type: Opaque
stringData:
  # The CNPG ObjectStore (and the app) read these standard AWS key names.
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_ACCESS_KEY_ID"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_SECRET_ACCESS_KEY"

---
# Example for Production (AWS S3 with IRSA)
# apiVersion: v1
# kind: Secret
# metadata:
#   name: postgres-backups-external
#   namespace: production
# type: Opaque
# stringData:
#   # Note: with IRSA the credential keys are not needed; configure the
#   # ServiceAccount with the eks.amazonaws.com/role-arn annotation instead.
