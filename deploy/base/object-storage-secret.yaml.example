# Example Kubernetes Secret for S3-compatible Object Storage Credentials
#
# USAGE:
# 1. Copy this file: cp object-storage-secret.yaml.example object-storage-secret.yaml
# 2. Replace values with your actual credentials
# 3. Encrypt with SOPS: sops -e -i object-storage-secret.yaml
# 4. Commit encrypted version to Git
#
# WARNING: Never commit unencrypted secrets to Git!

apiVersion: v1
kind: Secret
metadata:
  name: postgres-backup-storage
  namespace: default
type: Opaque
stringData:
  # S3 Access Key ID (AWS IAM user or MinIO access key)
  ACCESS_KEY_ID: "REPLACE_WITH_ACCESS_KEY_ID"
  
  # S3 Secret Access Key (AWS IAM secret or MinIO secret key)
  ACCESS_SECRET_KEY: "REPLACE_WITH_SECRET_ACCESS_KEY"
  
  # S3 Bucket Name (must exist and be accessible with above credentials)
  BUCKET_NAME: "postgres-backups"
  
  # S3 Endpoint URL (for MinIO or S3-compatible storage)
  # AWS S3: Leave empty or set to https://s3.amazonaws.com
  # MinIO: http://minio.minio.svc.cluster.local:9000
  # Other: Your S3-compatible endpoint URL
  ENDPOINT_URL: "http://minio.minio.svc.cluster.local:9000"
  
  # AWS Region (optional, for AWS S3 only)
  # Examples: us-east-1, eu-west-1, ap-southeast-1
  # Leave empty for MinIO or non-AWS S3
  AWS_REGION: ""

---
# Example for Production (AWS S3 with IRSA)
# apiVersion: v1
# kind: Secret
# metadata:
#   name: postgres-backup-storage
#   namespace: production
# type: Opaque
# stringData:
#   BUCKET_NAME: "postgres-backups-prod"
#   AWS_REGION: "us-east-1"
#   # Note: ACCESS_KEY_ID and ACCESS_SECRET_KEY not needed with IRSA
#   # Instead, configure ServiceAccount with eks.amazonaws.com/role-arn annotation
