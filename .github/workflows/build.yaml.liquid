# =============================================================================
# Build Workflow
# =============================================================================
#
# This workflow builds container images and pushes them to GitHub Container
# Registry (ghcr.io). It is designed to work with the GitOps deployment pattern
# where FluxCD reconciles manifests after the deploy workflow updates them.
#
# Triggers:
#   - Push to main branch: Builds and optionally deploys to dev
#   - Push of version tags (v*): Builds release images
#
# Outputs:
#   - image-tag: The semantic version or SHA-based tag
#   - image-digest: The immutable image digest for deployment
#
# Customization:
#   - Modify REGISTRY and IMAGE_NAME env vars for different registries
#   - Adjust cache settings for build performance
#   - Add additional build arguments as needed
#
# Template Variables (Liquid):
#   - {{ project_name }}: Project name from template
#   - {{ github_org }}: GitHub organization
#
# =============================================================================

name: Build

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:
    inputs:
      deploy:
        description: 'Deploy after build'
        required: false
        type: boolean
        default: false
      environment:
        description: 'Target environment (if deploy=true)'
        required: false
        type: choice
        options:
          - dev
          - staging

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: {% raw %}${{ github.repository }}{% endraw %}

jobs:
  build:
    runs-on: ubuntu-latest
    outputs:
      image-tag: {% raw %}${{ steps.meta.outputs.version }}{% endraw %}
      image-digest: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
      image-ref: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: {% raw %}${{ env.REGISTRY }}{% endraw %}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      
      - name: Extract Docker metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: {% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}{% endraw %}
          tags: |
            # SHA-based tag for every build
            type=sha,prefix=sha-,format=short
            # Semantic version from git tags
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}{% endraw %}
            # Latest tag for main branch
            type=raw,value=latest,enable={% raw %}${{ github.ref == format('refs/heads/{0}', 'main') }}{% endraw %}
      
      - name: Build and push container image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          # Build arguments can be customized here
          build-args: |
            RUST_VERSION=1.75
      
      - name: Generate build summary
        run: |
          echo "## Build Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Image:** \`{% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}{% endraw %}\`" >> $GITHUB_STEP_SUMMARY
          echo "**Tag:** \`{% raw %}${{ steps.meta.outputs.version }}{% endraw %}\`" >> $GITHUB_STEP_SUMMARY
          echo "**Digest:** \`{% raw %}${{ steps.build.outputs.digest }}{% endraw %}\`" >> $GITHUB_STEP_SUMMARY

  # Deploy job - called after successful build on main branch
  deploy-dev:
    needs: build
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    uses: ./.github/workflows/deploy.yaml.liquid
    with:
      image-tag: {% raw %}${{ needs.build.outputs.image-tag }}{% endraw %}
      image-digest: {% raw %}${{ needs.build.outputs.image-digest }}{% endraw %}
      environment: dev
    secrets: inherit
