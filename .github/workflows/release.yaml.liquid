name: Release

on:
  push:
    tags:
      - 'v*'

env:
  REGISTRY: {{ image_registry }}
  IMAGE_NAME: {% raw %}${{ github.repository }}{% endraw %}
  CARGO_TERM_COLOR: always

jobs:
  # ==========================================================================
  # Create GitHub Release
  # ==========================================================================
  create-release:
    name: Create Release
    runs-on: ubuntu-latest
    permissions:
      contents: write
    outputs:
      upload_url: {% raw %}${{ steps.create_release.outputs.upload_url }}{% endraw %}
      version: {% raw %}${{ steps.get_version.outputs.version }}{% endraw %}
    steps:
      - uses: actions/checkout@v6

      - name: Get version from tag
        id: get_version
        run: echo "version=${GITHUB_REF#refs/tags/v}" >> $GITHUB_OUTPUT

      - name: Create Release
        id: create_release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: {% raw %}${{ github.ref }}{% endraw %}
          name: Release {% raw %}${{ steps.get_version.outputs.version }}{% endraw %}
          body: |
            ## Release {% raw %}${{ steps.get_version.outputs.version }}{% endraw %}
            
            ### Container Images
            
            ```bash
            docker pull {% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ steps.get_version.outputs.version }}{% endraw %}
            ```
            
            ### Deployment
            
            This release is automatically deployable via Flux ImagePolicy using the `release` policy.
            
            See the [deployment documentation](../docs/DEPLOYMENT.md) for details.
          draft: false
          prerelease: false

  # ==========================================================================
  # Build & Push Release Image
  # ==========================================================================
  build-release:
    name: Build Release Image
    runs-on: ubuntu-latest
    needs: create-release
    permissions:
      contents: read
      packages: write
    outputs:
      image-tag: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
      image-digest: {% raw %}${{ steps.build-push.outputs.digest }}{% endraw %}
    steps:
      - uses: actions/checkout@v6

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Container Registry
        uses: docker/login-action@v3
        with:
          registry: {% raw %}${{ env.REGISTRY }}{% endraw %}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Generate image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: {% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}{% endraw %}
          tags: |
            # SemVer tags (v1.0.0 -> 1.0.0, 1.0, 1)
            type=semver,pattern={% raw %}{{version}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}.{{minor}}{% endraw %}
            type=semver,pattern={% raw %}{{major}}{% endraw %}
            # Release tag for ImagePolicy
            type=raw,value=release
            # Git SHA for traceability
            type=sha,prefix=sha-,format=short

      - name: Build and push release image
        id: build-push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          platforms: linux/amd64
          # Note: RUST_BASE_IMAGE_TAG=release assumes rust:release exists
          # If not available, the Dockerfile's ARG default (1.92-slim) is used
          build-args: |
            RUST_BASE_IMAGE_TAG=release

      - name: Image digest
        run: |
          echo "Release image built and pushed:"
          echo "Version: {% raw %}${{ needs.create-release.outputs.version }}{% endraw %}"
          echo "Digest: {% raw %}${{ steps.build-push.outputs.digest }}{% endraw %}"
          echo "Tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}"

  # ==========================================================================
  # Security Scan
  # ==========================================================================
  security-scan:
    name: Security Scan
    runs-on: ubuntu-latest
    needs: build-release
    permissions:
      security-events: write
      contents: read
    steps:
      - uses: actions/checkout@v6

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: {% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@${{ needs.build-release.outputs.image-digest }}{% endraw %}
          format: 'sarif'
          output: 'trivy-results.sarif'
          severity: 'CRITICAL,HIGH'

      - name: Upload Trivy scan results
        uses: github/codeql-action/upload-sarif@v4
        with:
          sarif_file: 'trivy-results.sarif'

      - name: Fail on vulnerabilities
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: {% raw %}${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@${{ needs.build-release.outputs.image-digest }}{% endraw %}
          format: 'table'
          exit-code: '1'
          severity: 'CRITICAL'
