version: "3.9"

services:
  # ==========================================================================
  # Application (for testing the container locally)
  # ==========================================================================
  app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      APP_ENV: development
      APP__SERVER__HOST: "0.0.0.0"
      APP__SERVER__PORT: "8080"
      APP__REDIS__URL: "redis://redis:6379"
      APP__TELEMETRY__OTLP_ENDPOINT: "http://otel-collector:4317"
      APP__TELEMETRY__SERVICE_NAME: "rust-service-local"
      APP__TELEMETRY__LOG_LEVEL: "debug"
      RUST_LOG: "debug,hyper=info,tower=info"
      {% if features contains "s3" %}
      APP__S3__ENDPOINT: "http://minio:9000"
      APP__S3__BUCKET: "data"
      APP__S3__REGION: "us-east-1"
      AWS_ACCESS_KEY_ID: "minioadmin"
      AWS_SECRET_ACCESS_KEY: "minioadmin"
      {% endif %}
    depends_on:
      redis:
        condition: service_healthy
      {% if features contains "s3" %}
      minio:
        condition: service_healthy
      {% endif %}
      otel-collector:
        condition: service_started
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8080/health/live"]
      interval: 10s
      timeout: 5s
      retries: 3

  # ==========================================================================
  # Redis
  # ==========================================================================
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  {% if features contains "s3" %}
  # ==========================================================================
  # MinIO (S3-compatible object storage)
  # ==========================================================================
  minio:
    image: minio/minio:latest
    command: server /data --console-address ":9001"
    ports:
      - "9000:9000"   # S3 API
      - "9001:9001"   # Web console
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 5s
      retries: 5

  # Creates the default bucket on startup
  minio-init:
    image: minio/mc:latest
    depends_on:
      minio:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
      mc alias set local http://minio:9000 minioadmin minioadmin;
      mc mb local/data --ignore-existing;
      exit 0;
      "
  {% endif %}

  # ==========================================================================
  # OpenTelemetry Collector (Simulates Knative infrastructure)
  # ==========================================================================
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.115.0
    command: ["--config=/etc/otel-collector-config.yaml"]
    volumes:
      - ./docker/otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    ports:
      - "4317:4317"   # OTLP gRPC (app sends here)
      - "4318:4318"   # OTLP HTTP
      - "9411:9411"   # Zipkin receiver (simulates Knative infra)
      - "8888:8888"   # Prometheus metrics from collector
    depends_on:
      - jaeger

  # ==========================================================================
  # Jaeger (Trace Visualization)
  # ==========================================================================
  jaeger:
    image: jaegertracing/all-in-one:1.63
    ports:
      - "16686:16686"  # Jaeger UI
      - "14250:14250"  # gRPC (for OTel collector)
    environment:
      COLLECTOR_OTLP_ENABLED: "true"

  # ==========================================================================
  # Prometheus (Optional - for local metrics testing)
  # ==========================================================================
  prometheus:
    image: prom/prometheus:v2.55.0
    ports:
      - "9090:9090"
    volumes:
      - ./docker/prometheus.yaml:/etc/prometheus/prometheus.yml:ro
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--web.enable-lifecycle'

volumes:
  redis-data:
  {% if features contains "s3" %}
  minio_data:
  {% endif %}
